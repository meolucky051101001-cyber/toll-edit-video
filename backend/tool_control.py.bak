"""Local control plane for the two fixed AutoDub installations."""
import json
import os
import secrets
import subprocess
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
import psutil
import voice_selection

ROOTS = {"v1": Path(r"C:\tool v1\backend"), "v2": Path(r"C:\tool v2\backend")}
PORTS = {"v1": 8088, "v2": 8089}
TOKEN = secrets.token_urlsafe(32)
LOCK = threading.Lock()
FLAGS = Path(r"C:\tool v1\workspace\control")
FLAGS.mkdir(parents=True, exist_ok=True)

def processes(key):
    root = ROOTS[key]
    scripts = {str(root / name).lower() for name in ("background_service.py", "main.py", "dashboard_monitor.py", "telegram_bot.py")}
    found = []
    for p in psutil.process_iter(["name", "cmdline", "cwd"]):
        try:
            if not (p.info["name"] or "").lower().startswith("python"):
                continue
            args = p.info["cmdline"] or []
            for arg in args[1:]:
                candidate = Path(arg)
                if not candidate.is_absolute():
                    candidate = Path(p.info["cwd"] or "") / candidate
                if str(candidate).lower() in scripts:
                    found.append((p, candidate.name))
                    break
        except (psutil.Error, OSError):
            continue
    return found

def read_telemetry(key):
    try:
        return json.loads((FLAGS / (key + '.json')).read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return {}

def status(key):
    procs = processes(key)
    bots = [p.pid for p, name in procs if name == 'telegram_bot.py']
    data = read_telemetry(key)
    fresh = data.get('pid') in bots and time.time() - data.get('at', 0) < 8
    dashboard = False
    try:
        with urllib.request.urlopen('http://127.0.0.1:%s/api/status' % PORTS[key], timeout=1) as response:
            dashboard = response.status == 200
    except Exception:
        pass
    ready = bool(fresh and data.get('polling') and dashboard)
    workers = [name for _, name in procs if name != 'background_service.py']
    state = 'running' if ready else 'stopped' if not bots else 'partial'
    return dict(key=key, state=state, dashboard=dashboard, bot=bool(bots),
                heartbeat=bool(fresh), polling=bool(fresh and data.get('polling')),
                busy=bool(data.get('busy')) if fresh else None,
                queue=data.get('queue', 0) if fresh else None,
                paused=(FLAGS / (key + '.pause')).exists())

def launch(key, service):
    root = ROOTS[key]
    subprocess.Popen([str(root/'venv/Scripts/pythonw.exe'), str(root/'background_service.py'), '--service', service],
                     cwd=root, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     creationflags=subprocess.CREATE_NO_WINDOW)

def change(key, action):
    if key not in ROOTS or action not in ('on', 'off'):
        raise ValueError('Yêu cầu không hợp lệ.')
    flag = FLAGS / (key + '.pause')
    if action == 'on':
        other = 'v2' if key == 'v1' else 'v1'
        if any(name == 'telegram_bot.py' for _, name in processes(other)):
            raise ValueError('Hãy tắt Tool ' + other.upper() + ' trước khi bật bot ' + key.upper() + ' để tránh xung đột Telegram.')
        flag.unlink(missing_ok=True)
        names = [name for _, name in processes(key)]
        if not any(n in names for n in ('main.py', 'dashboard_monitor.py')):
            launch(key, 'dashboard')
        if 'telegram_bot.py' not in names:
            launch(key, 'telegram')
        return 'Đã yêu cầu bật. Chờ dashboard và heartbeat Telegram xác nhận.'
    procs = processes(key)
    bots = [p.pid for p, name in procs if name == 'telegram_bot.py']
    data = read_telemetry(key)
    if bots and (data.get('pid') not in bots or time.time()-data.get('at',0)>8):
        raise ValueError('Chưa xác minh bot rảnh. Cần nạp bản heartbeat trước khi tắt.')
    if bots and (data.get('busy') or data.get('queue')):
        raise ValueError('Tool còn video đang xử lý hoặc trong hàng đợi. Chờ hoàn tất rồi tắt.')
    # Freeze admissions before checking again; a new job cannot race the stop.
    flag.write_text('paused', encoding='utf-8')
    try:
        if bots:
            previous = data.get('at',0)
            deadline = time.monotonic()+8
            while time.monotonic()<deadline:
                data = read_telemetry(key)
                if data.get('at',0)>previous and data.get('paused'):
                    break
                time.sleep(.2)
            else:
                raise ValueError('Bot chưa xác nhận tạm ngừng nhận việc; chưa tắt.')
            if data.get('busy') or data.get('queue'):
                raise ValueError('Có video vừa vào hàng đợi. Chờ xử lý xong rồi tắt.')
        # Check local batch work as well, independently of Telegram.
        if key == 'v1':
            try:
                with urllib.request.urlopen('http://127.0.0.1:8088/api/status',timeout=2) as r:
                    if json.load(r).get('active'):
                        raise ValueError('Batch trên dashboard đang chạy; chưa thể tắt.')
            except (OSError, TimeoutError):
                if any(n=='main.py' for _, n in procs):
                    raise ValueError('Không xác minh được batch; chưa tắt.')
        # Keep dashboards online: the switch controls the processing bot.
        procs = [(p, name) for p, name in procs if name == 'telegram_bot.py' or
                 (name == 'background_service.py' and 'telegram' in p.cmdline())]
        targets = {}
        for p, _ in procs:
            try:
                for child in p.children(recursive=True):
                    # The shared controller must survive stopping its original launcher.
                    try:
                        if any(Path(arg).name.lower() == 'tool_control.py' for arg in child.cmdline()[1:]):
                            continue
                    except psutil.Error:
                        continue
                    targets[child.pid]=child
                targets[p.pid]=p
            except psutil.NoSuchProcess: pass
        # psutil tracks creation time to prevent PID reuse from killing another app.
        for p, name in procs:
            if name=='background_service.py':
                try: p.terminate()
                except psutil.NoSuchProcess: pass
        for p in targets.values():
            try: p.terminate()
            except psutil.NoSuchProcess: pass
        _, alive = psutil.wait_procs(list(targets.values()), timeout=5)
        if alive: raise ValueError('Một số tiến trình chưa dừng. Kiểm tra trạng thái trước khi chuyển tool.')
    except Exception:
        flag.unlink(missing_ok=True)
        raise
    return 'Đã tắt bộ xử lý và Telegram bot. Dashboard vẫn mở để xem log và bật lại.'

def change_voice(voice_id):
    for key in ROOTS:
        current = status(key)
        if current['bot'] and (not current['heartbeat'] or current['busy'] or current['queue']):
            raise ValueError('Tool đang xử lý hoặc còn hàng đợi; hãy chờ hoàn tất rồi đổi giọng.')
    try:
        with urllib.request.urlopen('http://127.0.0.1:8088/api/status', timeout=2) as response:
            if json.load(response).get('active'):
                raise ValueError('Batch đang xử lý. Hãy chờ hoàn tất rồi đổi giọng.')
    except (OSError, TimeoutError):
        raise ValueError('Không xác minh được batch V1; chưa đổi giọng.')
    voice_selection.save(voice_id)
    return 'Đã lưu: ' + voice_selection.selected()['label'] + '. Video tiếp theo sẽ dùng giọng này.'

HTML = """<!doctype html><html lang="vi"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Điều khiển V1 / V2</title>
<style>body{margin:0;padding:12px;background:#151f2e;color:#e2e8f0;font:14px system-ui}h2{font-size:16px;margin:0 0 10px}.tools{display:flex;gap:12px;flex-wrap:wrap}.tool{flex:1;min-width:240px;border:1px solid #42516a;border-radius:10px;padding:12px}.dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:#f59e0b;margin-right:8px}.running{background:#22c55e}.stopped{background:#ef4444}button,a{color:#fff;background:#243a54;border:1px solid #53647a;border-radius:6px;padding:6px 12px;cursor:pointer;text-decoration:none}button[role=switch]{display:inline-flex;align-items:center;gap:9px;border:0;background:transparent;padding:3px 8px 3px 0;touch-action:pan-y;user-select:none;vertical-align:middle}.switch-track{display:inline-block;position:relative;width:58px;height:30px;border-radius:18px;background:#b83240;border:1px solid #ef6974;box-shadow:inset 0 1px 4px #0005;transition:background .2s}.switch-thumb{position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:50%;background:#fff;box-shadow:0 2px 5px #0005;transition:transform .2s}button[role=switch][aria-checked=true] .switch-track{background:#149960;border-color:#35d58b}button[role=switch][aria-checked=true] .switch-thumb{transform:translateX(28px)}button[role=switch][data-state=partial] .switch-track{background:#b7791f;border-color:#fbbf24}.switch-label{min-width:30px;font-weight:600}@media(prefers-reduced-motion:reduce){.switch-track,.switch-thumb{transition:none}}button:disabled{opacity:.5;cursor:wait}small{display:block;color:#bac9dc;margin:8px 0}#message{margin-top:10px;color:#fcd34d}a{font-size:12px}button:focus-visible,a:focus-visible{outline:2px solid #7dd3fc}</style>
<h2>Tool & Telegram bot</h2><div class="tools" id="tools"></div><div id="message" role="status">Đang kiểm tra dịch vụ…</div>
<section style="margin-top:12px;border-top:1px solid #42516a;padding-top:12px"><label for="voice"><b>Giọng lồng tiếng · dùng chung V1 / V2 và Telegram</b></label><small>Chọn giọng để tự lưu khi tool rảnh. Giọng đã lưu hiển thị bên dưới.</small><select id="voice" onchange="saveVoice()" style="max-width:100%;background:#243a54;color:white;padding:8px;border-radius:6px" disabled></select> <button id="save-voice" onclick="saveVoice()" disabled>Lưu giọng</button><small id="voice-status" role="status">Đang tải danh sách giọng…</small></section>
<script>const token='__TOKEN__';let pending=false;let states=[];let dragStart=null;let suppressClickUntil=0;
async function refresh(){try{const r=await fetch('/status');if(!r.ok)throw Error();states=await r.json();document.getElementById('tools').innerHTML=states.map(s=>`<div class="tool"><span class="dot ${s.state}"></span><b>Tool ${s.key.toUpperCase()}</b> · ${s.state==='running'?'Đang chạy':s.state==='stopped'?'Đã tắt':'Chưa sẵn sàng'}<small>Dashboard: ${s.dashboard?'online':'offline'} · Bot: ${s.polling?'polling hoạt động':s.bot?'đang khởi động / chưa xác minh':'đã tắt'}${s.busy?' · Đang xử lý':''}${s.queue?' · '+s.queue+' video chờ':''}</small><button role="switch" aria-label="Bật tắt Tool ${s.key.toUpperCase()} và Telegram bot" aria-checked="${s.state==='running'}" data-state="${s.state}" title="Kéo sang phải để bật, sang trái để tắt; hoặc bấm công tắc" onpointerdown="beginSwitch(event)" onpointerup="endSwitch(event,'${s.key}')" onpointercancel="dragStart=null" ${pending?'disabled':''} onclick="if(Date.now()>suppressClickUntil)toggle('${s.key}','${s.state==='stopped'?'on':'off'}')"><span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span><span class="switch-label">${pending?'Đang đổi…':s.state==='running'?'Bật':s.state==='stopped'?'Tắt':'Chờ xác nhận'}</span></button> ${s.state==='partial'?`<button ${pending?'disabled':''} onclick="toggle('${s.key}','on')">Khởi động bổ sung</button>`:''} <a target="_top" href="http://127.0.0.1:${s.key==='v1'?8088:8089}/">Dashboard ↗</a></div>`).join('');}catch(e){document.getElementById('message').textContent='Mất kết nối bộ điều khiển; trạng thái chưa xác minh.';document.querySelectorAll('.dot').forEach(d=>d.className='dot');}}
function beginSwitch(event){if(pending)return;dragStart={x:event.clientX,id:event.pointerId};event.currentTarget.setPointerCapture(event.pointerId);}
function endSwitch(event,key){if(!dragStart)return;const dx=event.clientX-dragStart.x;dragStart=null;if(Math.abs(dx)<12)return;suppressClickUntil=Date.now()+500;const state=states.find(s=>s.key===key);const action=dx>0?'on':'off';if((action==='on'&&state.state==='running')||(action==='off'&&state.state==='stopped'))return;toggle(key,action);}
async function toggle(key,action){if(pending)return;pending=true;await refresh();try{const r=await fetch('/control',{method:'POST',headers:{'Content-Type':'application/json','X-Control-Token':token},body:JSON.stringify({key,action})});const d=await r.json();document.getElementById('message').textContent=d.message;}catch(e){document.getElementById('message').textContent='Không gửi được lệnh. Hãy kiểm tra kết nối.';}finally{pending=false;refresh();}}
async function loadVoices(){try{const r=await fetch('/voices');if(!r.ok)throw Error();const d=await r.json();const select=document.getElementById('voice');select.replaceChildren();for(const source of ['rvc','edge','capcut']){const group=document.createElement('optgroup');group.label={rvc:'Giọng mặc định · RVC',edge:'Microsoft TTS',capcut:'CapCut TTS'}[source];for(const v of d.voices.filter(v=>v.source===source)){const option=document.createElement('option');option.value=v.id;option.textContent=v.label+(v.verified_at?' ✓':'');group.append(option);}select.append(group);}select.value=d.selected.id;select.disabled=false;document.getElementById('save-voice').disabled=false;document.getElementById('voice-status').textContent='Đang lưu: '+d.selected.label;}catch(e){document.getElementById('voice-status').textContent='Không tải được cấu hình giọng. Hãy tải lại trang.';}}
async function saveVoice(){const button=document.getElementById('save-voice');const select=document.getElementById('voice');button.disabled=true;select.disabled=true;try{const r=await fetch('/voices',{method:'POST',headers:{'Content-Type':'application/json','X-Control-Token':token},body:JSON.stringify({id:select.value})});const d=await r.json();if(!r.ok)throw Error(d.message||'Không lưu được giọng');await loadVoices();document.getElementById('voice-status').textContent=d.message;}catch(e){await loadVoices();alert('Giọng chưa được đổi: '+e.message);}finally{button.disabled=false;select.disabled=false;}}
loadVoices();refresh();setInterval(()=>{if(!pending&&!dragStart)refresh()},3000);document.getElementById('message').textContent='Xanh: dashboard + bot hoạt động · Đỏ: bộ xử lý/bot đã tắt · Vàng: chưa sẵn sàng. Tắt tool khi hàng đợi đã hoàn tất.';
</script></html>"""
class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args): pass
    def send(self, code, data, mime='application/json'):
        raw = data.encode('utf-8') if isinstance(data,str) else json.dumps(data,ensure_ascii=False).encode('utf-8')
        self.send_response(code)
        self.send_header('Content-Type',mime+'; charset=utf-8')
        self.send_header('Cache-Control','no-store')
        self.send_header('Content-Security-Policy',"frame-ancestors http://127.0.0.1:8088 http://localhost:8088 http://127.0.0.1:8089 http://localhost:8089 http://127.0.0.1:8090")
        self.end_headers();self.wfile.write(raw)
    def trusted(self):
        return self.headers.get('Host') in ('127.0.0.1:8090','localhost:8090')
    def do_GET(self):
        if not self.trusted(): return self.send(403,{'message':'Invalid host'})
        if self.path=='/': return self.send(200,HTML.replace('__TOKEN__',TOKEN),'text/html')
        if self.path=='/voices': return self.send(200,{'voices':voice_selection.catalog(),'selected':voice_selection.selected()})
        if self.path=='/status': return self.send(200,[status(k) for k in ROOTS])
        self.send(404,{})
    def do_POST(self):
        if not self.trusted() or self.path not in ('/control','/voices') or not secrets.compare_digest(self.headers.get('X-Control-Token',''),TOKEN):
            return self.send(403,{'message':'Unauthorized'})
        if not LOCK.acquire(blocking=False): return self.send(409,{'message':'Đang thực hiện lệnh khác.'})
        try:
            size=int(self.headers.get('Content-Length','0'))
            if not 0<size<512: raise ValueError('Invalid request')
            data=json.loads(self.rfile.read(size))
            if not isinstance(data,dict): raise ValueError('Invalid request')
            message = change_voice(data.get('id')) if self.path=='/voices' else change(data.get('key'),data.get('action'))
            self.send(200,{'message':message})
        except (ValueError, OSError, psutil.Error) as e:
            self.send(409,{'message':str(e)})
        finally: LOCK.release()

if __name__=='__main__':
    try: server=ThreadingHTTPServer(('127.0.0.1',8090),Handler)
    except OSError: raise SystemExit(0)
    server.serve_forever()
