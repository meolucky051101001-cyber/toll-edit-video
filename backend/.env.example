# Copy this file to backend/.env and fill in secrets locally. Never commit .env.
PIPELINE_MODE=v2
BOT_TOKEN=
BOT_EXPECTED_USERNAME=autodub_video_v2_bot
BOT_DISPLAY_NAME=AutoDub Video Bot V2
BOT_SHORT_DESCRIPTION=Lồng tiếng video tự động bằng Pipeline V2.
BOT_DESCRIPTION=Gửi link hoặc video để tải sạch, nhận dạng lời thoại, dịch, lồng tiếng, đồng bộ thời gian và kiểm tra chất lượng.
GEMINI_API_KEY=
FPT_API_KEY=

# Douyin anti-bot access. Prefer a dedicated Netscape/yt-dlp cookie file.
# Never commit that file or paste its contents into logs/screenshots.
DOUYIN_COOKIE_FILE=
# DOUYIN_COOKIE=msToken=...; ttwid=...; odin_tt=...
DOUYIN_API_TIMEOUT_SECONDS=12

# Strong-model runtime (kept isolated from the bot venv for stability).
MODEL_RUNTIME_PYTHON=
AUTODUB_MODEL_CACHE=
SOURCE_SEPARATOR_BACKEND=auto
SOURCE_SEPARATOR_MODEL=model_bs_roformer_ep_317_sdr_12.9755.ckpt
DEMUCS_MODEL=htdemucs_ft
DEMUCS_FALLBACK_MODEL=htdemucs
ASR_BACKEND=auto
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-0.6B
QWEN_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
QWEN_ASR_LANGUAGE=Chinese
WHISPER_MODEL=large-v3
OCR_BACKEND=auto
PADDLE_OCR_VERSION=PP-OCRv6
PADDLE_OCR_ENGINE=onnxruntime
GEMINI_MODEL=gemini-3.8-flash
# Model riêng cho Studio Kịch Bản (ưu tiên trước tiên khi viết kịch bản animation; rỗng = dùng GEMINI_MODEL)
GEMINI_SCRIPT_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o
DEEPSEEK_MODEL=deepseek-chat

# Optional paths. Empty values use portable defaults; relative values resolve
# from the repository root. On Windows, defaults use LocalAppData for workspace
# and the user's Videos\AutoDubV2 folder for input/output.
AUTODUB_DATA_DIR=
AUTODUB_WORKSPACE=
AUTODUB_INPUT_DIR=
AUTODUB_OUTPUT_DIR=
AUTODUB_SHARED_ASSETS_DIR=
AUTODUB_SHARED_WORKSPACE_DIR=
AUTODUB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,null

ENABLE_STAGE_CACHE=true
ENABLE_GPU_PROCESS_ISOLATION=true
ENABLE_PARALLEL_OCR_GEMINI=false
ENABLE_ADAPTIVE_DEMUCS=false
ENABLE_ADAPTIVE_OCR=true
ENABLE_TIMING_SOLVER=true
ENABLE_FFMPEG_MIX_V2=true
ENABLE_LEGACY_MIX_AB=false
ENABLE_RVC=true
ENABLE_AUTO_GENDER=false
PRESERVE_SOURCE_RESOLUTION=true

ATEMPO_MIN=0.92
ATEMPO_MAX=1.40
TARGET_LUFS=-15
TRUE_PEAK_MAX_DBTP=-1
QC_GATE_POLICY=block

GPU_LOCK_TIMEOUT_SECONDS=1800
STAGE_TIMEOUT_SECONDS=3600
TRANSLATION_BATCH_SEGMENTS=80
TRANSLATION_BATCH_CHARACTERS=12000
OCR_BATCH_SEGMENTS=80
TTS_BATCH_SEGMENTS=64
RVC_BATCH_SEGMENTS=64
MIXER_CHUNK_SECONDS=300
MIXER_MAX_INPUTS_PER_PASS=64

# ---------------------------------------------------------------------------
# Studio Kịch Bản (/kich-ban) — nâng cấp render qua Node sidecar (tools/render_node)
# ---------------------------------------------------------------------------
# Band A (banner tiêu đề) render bằng Satori (HTML/CSS -> SVG -> resvg). 0=tắt (mặc định), 1=bật.
# Yêu cầu khi bật: node trên PATH + đã chạy `npm install` trong tools/render_node (lỗi sẽ tự lùi về PIL).
SCRIPT_SATORI_BAND_A=0
# Engine Remotion (PoC) cho phân cảnh doodle. 0=tắt (mặc định), 1=bật.
SCRIPT_REMOTION_ENABLED=0

# ---------------------------------------------------------------------------
# Telegram bot rieng cho Studio Kich Ban (telegram_script_bot.py)
# ---------------------------------------------------------------------------
# Token bot Telegram (lay tu BotFather). Bot nay CHI lo prompt -> kich ban -> video doodle 9:16.
# Chay: venv\Scripts\pythonw.exe background_service.py --service scriptbot
TELEGRAM_SCRIPT_BOT_TOKEN=PASTE_TELEGRAM_SCRIPT_BOT_TOKEN
# Danh sach Chat ID duoc phep (phan cach dau phay). De trong = mo cho moi nguoi (giong bot AutoDub).
# Lay chat id bang lenh /chatid tren bot. Vi du: 123456789,987654321
TELEGRAM_SCRIPT_ALLOWED_CHAT_IDS=

# Copy guong video thanh pham (doodle) sang thu muc luu tru. De trong = TAT (mac dinh).
# Vi du: SCRIPT_OUTPUT_COPY_DIR=D:\kich_ban  (video dung xong duoc copy them 1 ban, loi copy khong lam hong render)
SCRIPT_OUTPUT_COPY_DIR=
