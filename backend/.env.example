# Copy this file to backend/.env and fill in secrets locally. Never commit .env.
PIPELINE_MODE=legacy
BOT_TOKEN=
GEMINI_API_KEY=
FPT_API_KEY=

# Tool V1: ưu tiên tốc độ và VRAM thấp; mọi model đều có fallback an toàn.
V1_WHISPER_MODEL=large-v3-turbo
V1_WHISPER_FALLBACK_MODEL=large-v3
V1_DEMUCS_MODEL=htdemucs
V1_OCR_BACKEND=auto
V1_PADDLE_DETECTION_MODEL=PP-OCRv6_tiny_det
V1_PADDLE_RECOGNITION_MODEL=PP-OCRv6_tiny_rec
V1_PADDLE_ENGINE=onnxruntime
V1_OCR_TIMEOUT_SECONDS=900
GEMINI_MODEL=gemini-3.8-flash

# Keep large mutable artifacts outside OneDrive/cloud-synced source folders.
AUTODUB_WORKSPACE=D:\autodub_workspace
AUTODUB_INPUT_DIR=D:\video_input
AUTODUB_OUTPUT_DIR=D:\banve
AUTODUB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,null

ENABLE_RVC=true
PRESERVE_SOURCE_RESOLUTION=true
