+async def run_api_pipeline_v2(
+    video_path,
+    out_dir,
+    final_video,
+    published_video,
+    target_lang,
+    voice_source,
+    voice_param,
+    api_key,
+):
+    """Run the shared v2 runner for API routes when rollout mode is v2."""
+
+    settings = PipelineSettings.from_env()
+    if settings.mode is not PipelineMode.V2:
+        return None
+
