APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
# Optional shared secret for the local API. Leave empty to disable auth
# (default localhost behaviour). When set, the Next.js proxy injects it
# automatically; direct API scripts must send header X-API-Token.
API_TOKEN=
USE_MOCK_PROVIDER=true
DEFAULT_RESULT_LIMIT=50
MAX_QUERIES=10
SEARCH_TIMEOUT=120
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
PLAYWRIGHT_HEADLESS=true
HYBRID_HEADLESS=true
BROWSER_AUTO_ELEVATE=true
BROWSER_INTERACTION_TIMEOUT=1800
DOUYIN_PROFILE_DIR=./data/browser/douyin
XHS_PROFILE_DIR=./data/browser/xiaohongshu
AI_FREE_TIER_CONFIRMED=false
AI_TIMEOUT=20
AI_MIN_INTERVAL=6

XHS_BROWSER_CHANNEL=chrome
# Optional: dedicated browser channel for Douyin. Empty = follow
# XHS_BROWSER_CHANNEL. Use msedge to isolate Douyin from Chrome sessions.
DOUYIN_BROWSER_CHANNEL=
DOWNLOAD_QUEUE_CAPACITY=100
DOWNLOAD_WORKER_COUNT=2
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_RETRY_BASE_DELAY=2.0
METRIC_SNAPSHOT_THROTTLE_SECONDS=300
